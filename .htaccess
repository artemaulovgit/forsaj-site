# ==========================================================================
#  FORSAJ MK — конфигурация Apache (хостинг reg.ru, «как есть» подходит)
# ==========================================================================

# ---------- Кодировка по умолчанию ----------
AddDefaultCharset UTF-8

# ---------- Главная страница ----------
DirectoryIndex index.html

# ---------- Редиректы со старых адресов Tilda ----------
<IfModule mod_rewrite.c>
    RewriteEngine On

    # /forsaj  ->  /
    RewriteRule ^forsaj/?$ / [R=301,L]

    # /forsaj_info  ->  /contacts.html
    RewriteRule ^forsaj_info/?$ /contacts.html [R=301,L]

    # /forsaj_map  ->  /map.html
    RewriteRule ^forsaj_map/?$ /map.html [R=301,L]

    # Старые индексы внутри папок
    RewriteRule ^forsaj/index\.html$ / [R=301,L]
    RewriteRule ^forsaj_info/index\.html$ /contacts.html [R=301,L]
    RewriteRule ^forsaj_map/index\.html$ /map.html [R=301,L]

    # Красивые адреса без .html (необязательно, но приятно)
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteCond %{REQUEST_FILENAME}.html -f
    RewriteRule ^([^\.]+)$ $1.html [L]
</IfModule>

# ---------- Страница 404 ----------
ErrorDocument 404 /404.html

# ---------- Сжатие ----------
<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/html text/plain text/css text/xml text/javascript
    AddOutputFilterByType DEFLATE application/javascript application/json application/xml
    AddOutputFilterByType DEFLATE image/svg+xml application/xhtml+xml
</IfModule>

# ---------- Кэширование статики ----------
<IfModule mod_expires.c>
    ExpiresActive On
    ExpiresByType text/html "access plus 0 seconds"
    ExpiresByType text/css "access plus 1 year"
    ExpiresByType application/javascript "access plus 1 year"
    ExpiresByType image/jpeg "access plus 1 year"
    ExpiresByType image/png "access plus 1 year"
    ExpiresByType image/svg+xml "access plus 1 year"
    ExpiresByType font/woff2 "access plus 1 year"
    ExpiresByType application/xml "access plus 1 day"
</IfModule>

# ---------- Заголовки безопасности ----------
<IfModule mod_headers.c>
    Header set X-Content-Type-Options "nosniff"
    Header set Referrer-Policy "strict-origin-when-cross-origin"
    Header set X-Frame-Options "SAMEORIGIN"
    Header set Permissions-Policy "geolocation=(), microphone=(), camera=()"
</IfModule>

# ---------- Запрет листинга каталогов ----------
Options -Indexes

# ---------- Кэш шрифтов для Safari ----------
<FilesMatch "\.(woff2)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
</FilesMatch>
